# ---------------------------------------------------------------------------
# Copy this file to .env and fill in the real values. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5000

# Paste your MongoDB Atlas / local connection string here.
# Example: mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/teamliva?retryWrites=true&w=majority
MONGODB_URI=

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:3000

# Optional. Only needed if a `mongodb+srv://` URI fails with "querySrv ECONNREFUSED"
# — that means Node's DNS resolver can't do SRV lookups. Point it somewhere that can.
# DNS_SERVERS=1.1.1.1,8.8.8.8

# Optional: used only by `npm run seed` to create the first admin account.
SEED_ADMIN_NAME=Teamliva Admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
